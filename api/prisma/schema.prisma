generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  email                 String          @unique
  passwordHash          String
  role                  UserRole        @default(STUDENT)
  schoolCode            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  decidedAccessRequests AccessRequest[] @relation("AccessRequestDecider")
  accessRequests        AccessRequest[]
  gradedSubmissions     Grade[]         @relation("GradedBy")
  createdPapers         QuestionPaper[] @relation("PaperCreator")
  submissions           Submission[]
}

model QuestionPaper {
  id                                String          @id @default(uuid()) @db.Uuid
  title                             String
  description                       String
  durationMinutes                   Int
  startDate                         DateTime
  endDate                           DateTime
  earlySubmissionRestrictionMinutes Int?
  status                            PaperStatus     @default(DRAFT)
  createdBy                         String          @db.Uuid
  createdAt                         DateTime        @default(now())
  updatedAt                         DateTime        @updatedAt
  accessRequests                    AccessRequest[]
  questions                         Question[]
  creator                           User            @relation("PaperCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  submissions                       Submission[]
}

model Question {
  id           String        @id @default(uuid()) @db.Uuid
  paperId      String        @db.Uuid
  contentHtml  String
  marks        Int
  position     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  paper        QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subQuestions SubQuestion[]

  @@unique([paperId, position])
}

model SubQuestion {
  id                       String       @id @default(uuid()) @db.Uuid
  questionId               String       @db.Uuid
  label                    String
  question                 String
  marks                    Int
  position                 Int
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  mcqOptions               Json?
  questionType             QuestionType @default(DESCRIPTIVE)
  circuitTemplate          Json?
  imageCompositionTemplate Json?
  answers                  Answer[]
  grades                   Grade[]
  questionRel              Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position, label])
}

model AccessRequest {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @db.Uuid
  paperId     String        @db.Uuid
  status      AccessStatus  @default(PENDING)
  decidedById String?       @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  decidedBy   User?         @relation("AccessRequestDecider", fields: [decidedById], references: [id])
  paper       QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, paperId])
}

model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  paperId     String           @db.Uuid
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  answers     Answer[]
  grades      Grade[]
  paper       QuestionPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, paperId])
}

model Answer {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @db.Uuid
  subQuestionId String      @db.Uuid
  answerText    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, subQuestionId])
}

model Grade {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @db.Uuid
  subQuestionId String      @db.Uuid
  assignedMarks Int
  gradedById    String?     @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  comment       String?
  gradedBy      User?       @relation("GradedBy", fields: [gradedById], references: [id])
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, subQuestionId])
}

model ExamSecurityConfig {
  id             String   @id
  unlockCodeHash String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum UserRole {
  STUDENT
  ADMIN
}

enum PaperStatus {
  DRAFT
  PUBLISHED
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

enum QuestionType {
  DESCRIPTIVE
  MCQ
  GRAPH
  TABLE
  CIRCUIT
  DRAWING
  IMAGE_COMPOSITION
}
