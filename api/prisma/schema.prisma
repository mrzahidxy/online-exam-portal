generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  email                 String             @unique
  passwordHash          String
  role                  UserRole           @default(STUDENT)
  schoolCode            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdPapers         QuestionPaper[]    @relation("PaperCreator")
  accessRequests        AccessRequest[]
  decidedAccessRequests AccessRequest[]    @relation("AccessRequestDecider")
  submissions           Submission[]
  gradedSubmissions     Grade[]            @relation("GradedBy")
  tenantMemberships     TenantMembership[]
}

model Tenant {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    TenantMembership[]
  papers         QuestionPaper[]
  accessRequests AccessRequest[]
  submissions    Submission[]
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
}

model QuestionPaper {
  id                                String          @id @default(uuid()) @db.Uuid
  tenantId                          String?         @db.Uuid
  title                             String
  description                       String
  durationMinutes                   Int
  startDate                         DateTime
  endDate                           DateTime
  earlySubmissionRestrictionMinutes Int?
  status                            PaperStatus     @default(DRAFT)
  createdBy                         String          @db.Uuid
  createdAt                         DateTime        @default(now())
  updatedAt                         DateTime        @updatedAt
  tenant                            Tenant?         @relation(fields: [tenantId], references: [id])
  creator                           User            @relation("PaperCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  questions                         Question[]
  accessRequests                    AccessRequest[]
  submissions                       Submission[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Question {
  id           String          @id @default(uuid()) @db.Uuid
  paperId      String          @db.Uuid
  contentHtml  String
  marks        Int
  position     Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  paper        QuestionPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subQuestions SubQuestion[]

  @@unique([paperId, position])
}

model SubQuestion {
  id           String        @id @default(uuid()) @db.Uuid
  questionId   String        @db.Uuid
  label        String
  question     String
  marks        Int
  questionType QuestionType  @default(DESCRIPTIVE)
  mcqOptions   Json?
  position     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  questionRel  Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers      Answer[]
  grades       Grade[]

  @@unique([questionId, position, label])
}

model AccessRequest {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String?       @db.Uuid
  studentId   String        @db.Uuid
  paperId     String        @db.Uuid
  status      AccessStatus  @default(PENDING)
  decidedById String?       @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper       QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  decidedBy   User?         @relation("AccessRequestDecider", fields: [decidedById], references: [id])

  @@unique([studentId, paperId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Submission {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String?           @db.Uuid
  studentId   String            @db.Uuid
  paperId     String            @db.Uuid
  status      SubmissionStatus  @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper       QuestionPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  answers     Answer[]
  grades      Grade[]

  @@unique([studentId, paperId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Answer {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @db.Uuid
  subQuestionId String      @db.Uuid
  answerText    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, subQuestionId])
}

model Grade {
  id            String     @id @default(uuid()) @db.Uuid
  submissionId  String     @db.Uuid
  subQuestionId String     @db.Uuid
  assignedMarks Int
  gradedById    String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  gradedBy      User?      @relation("GradedBy", fields: [gradedById], references: [id])
  comment       String?

  @@unique([submissionId, subQuestionId])
}

enum UserRole {
  STUDENT
  ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum PaperStatus {
  DRAFT
  PUBLISHED
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

enum QuestionType {
  DESCRIPTIVE
  MCQ
  GRAPH
  TABLE
}
