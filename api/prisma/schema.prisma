generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  email                 String                 @unique
  passwordHash          String
  platformRole          PlatformRole           @default(USER)
  schoolCode            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           OrganizerMembership[]
  createdPapers         QuestionPaper[]        @relation("PaperCreator")
  accessRequests        AccessRequest[]
  decidedAccessRequests AccessRequest[]        @relation("AccessRequestDecider")
  submissions           Submission[]
  gradedSubmissions     Grade[]                @relation("GradedBy")
}

model Organizer {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  slug               String                 @unique
  status             OrganizerStatus        @default(ACTIVE)
  subscriptionStatus SubscriptionStatus     @default(TRIAL)
  subscriptionEndsAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  memberships        OrganizerMembership[]
  papers             QuestionPaper[]
  accessRequests     AccessRequest[]
  submissions        Submission[]
}

model OrganizerMembership {
  id          String           @id @default(uuid()) @db.Uuid
  organizerId String           @db.Uuid
  userId      String           @db.Uuid
  role        OrganizerRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  organizer   Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizerId])
  @@index([organizerId])
  @@index([userId, status])
  @@index([organizerId, role, status])
}

model QuestionPaper {
  id                                String          @id @default(uuid()) @db.Uuid
  organizerId                       String          @db.Uuid
  title                             String
  description                       String
  durationMinutes                   Int
  startDate                         DateTime
  endDate                           DateTime
  earlySubmissionRestrictionMinutes Int?
  status                            PaperStatus     @default(DRAFT)
  createdBy                         String          @db.Uuid
  createdAt                         DateTime        @default(now())
  updatedAt                         DateTime        @updatedAt
  organizer                         Organizer       @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  creator                           User            @relation("PaperCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  questions                         Question[]
  accessRequests                    AccessRequest[]
  submissions                       Submission[]

  @@index([organizerId, status, startDate])
  @@index([organizerId, createdAt])
}

model Question {
  id           String          @id @default(uuid()) @db.Uuid
  paperId      String          @db.Uuid
  contentHtml  String
  marks        Int
  position     Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  paper        QuestionPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  subQuestions SubQuestion[]

  @@unique([paperId, position])
}

model SubQuestion {
  id           String        @id @default(uuid()) @db.Uuid
  questionId   String        @db.Uuid
  label        String
  question     String
  marks        Int
  questionType QuestionType  @default(DESCRIPTIVE)
  mcqOptions   Json?
  position     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  questionRel  Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers      Answer[]
  grades       Grade[]

  @@unique([questionId, position, label])
}

model AccessRequest {
  id          String        @id @default(uuid()) @db.Uuid
  organizerId String        @db.Uuid
  studentId   String        @db.Uuid
  paperId     String        @db.Uuid
  status      AccessStatus  @default(PENDING)
  decidedById String?       @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  organizer   Organizer     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper       QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  decidedBy   User?         @relation("AccessRequestDecider", fields: [decidedById], references: [id])

  @@unique([studentId, paperId])
  @@index([organizerId, status, createdAt])
  @@index([organizerId, paperId, status])
}

model Submission {
  id          String            @id @default(uuid()) @db.Uuid
  organizerId String            @db.Uuid
  studentId   String            @db.Uuid
  paperId     String            @db.Uuid
  status      SubmissionStatus  @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  organizer   Organizer         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper       QuestionPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  answers     Answer[]
  grades      Grade[]

  @@unique([studentId, paperId])
  @@index([organizerId, status, submittedAt])
  @@index([organizerId, paperId])
}

model Answer {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @db.Uuid
  subQuestionId String      @db.Uuid
  answerText    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, subQuestionId])
}

model Grade {
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @db.Uuid
  subQuestionId String      @db.Uuid
  assignedMarks Int
  gradedById    String?     @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  gradedBy      User?       @relation("GradedBy", fields: [gradedById], references: [id])
  comment       String?

  @@unique([submissionId, subQuestionId])
}

enum PlatformRole {
  ADMIN
  USER
}

enum OrganizerRole {
  OWNER
  STUDENT
}

enum OrganizerStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum PaperStatus {
  DRAFT
  PUBLISHED
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

enum QuestionType {
  DESCRIPTIVE
  MCQ
  GRAPH
  TABLE
}
