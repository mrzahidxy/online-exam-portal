# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# Database
DATABASE_URL="postgresql://exam_user:exam_password@localhost:5433/eassessment_app?schema=public"
DIRECT_URL="postgresql://exam_user:exam_password@localhost:5433/eassessment_app?schema=public"

# JWT
JWT_SECRET="change_me_to_a_strong_random_secret_value_at_least_32_chars"
JWT_EXPIRES_IN=60m
JWT_ISSUER="e-assessment-api"
ACCESS_TOKEN_TTL_MINUTES=60

# Cookies
ACCESS_TOKEN_COOKIE_NAME="auth-token"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
# COOKIE_DOMAIN=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# In production, set CORS_ORIGIN to the exact frontend origin(s), comma-separated.
# Use COOKIE_SECURE=true. Use COOKIE_SAME_SITE=none only for cross-site frontend/API
# deployments; it requires HTTPS. COOKIE_DOMAIN may be set to a shared parent domain
# when using sibling subdomains. Never use a wildcard CORS origin with credentials.

# Client URL
CLIENT_URL="http://localhost:3000"

# Upload
MAX_UPLOAD_SIZE=52428800

# Cloudinary media upload (server-side only; do not expose the secret to the client)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="online-exam-portal"
