# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false

# Database
DATABASE_URL="postgresql://exam_user:exam_password@localhost:5433/eassessment_app?schema=public"
DIRECT_URL="postgresql://exam_user:exam_password@localhost:5433/eassessment_app?schema=public"

# JWT
JWT_SECRET="change_me_to_a_strong_random_secret_value_at_least_32_chars"
JWT_EXPIRES_IN=60m
JWT_ISSUER="e-assessment-api"
ACCESS_TOKEN_TTL_MINUTES=60

# Cookies
ACCESS_TOKEN_COOKIE_NAME="auth-token"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
# COOKIE_DOMAIN=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# Google Cloud Storage
GCP_BUCKET_NAME="your_bucket_name"

# Client URL
CLIENT_URL="http://localhost:3000"

# Upload
MAX_UPLOAD_SIZE=5242880
